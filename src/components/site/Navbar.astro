---
import Logo from "./Logo.astro";
import LangToggle from "./LangToggle";
import MobileNav from "./MobileNav";
import ThemeToggle from "./ThemeToggle";

const links = [
  { href: "#about", id: "Tentang Kami", en: "About Us" },
  { href: "#news", id: "News", en: "News" },
  { href: "#members", id: "Member", en: "Members" },
  { href: "#destinations", id: "Destinasi", en: "Destinations" },
];
---

<header class="fixed inset-x-0 top-0 z-40" id="site-header">
  <div
    id="header-inner"
    class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4 transition-all duration-300 sm:px-8"
  >
    <a href="#top" class="shrink-0">
      <Logo />
    </a>

    <nav class="hidden items-center gap-8 lg:flex">
      {links.map((l) => (
        <a
          href={l.href}
          class="font-display text-sm font-semibold tracking-wide text-heading/80 transition-colors hover:text-reef"
        >
          <span lang="id">{l.id}</span>
          <span lang="en">{l.en}</span>
        </a>
      ))}
    </nav>

    <div class="hidden items-center gap-3 lg:flex">
      <ThemeToggle client:load />
      <LangToggle client:load />
      <a
        href="#members"
        class="rounded-full bg-coral px-5 py-2.5 font-display text-sm font-bold text-foam shadow-sm shadow-coral/30 transition-transform hover:-translate-y-0.5"
      >
        <span lang="id">Bergabung</span>
        <span lang="en">Join Us</span>
      </a>
    </div>

    <div class="lg:hidden">
      <MobileNav client:load />
    </div>
  </div>
</header>

<script is:inline>
  const header = document.getElementById("header-inner");
  const onScroll = () => {
    if (!header) return;
    if (window.scrollY > 24) {
      header.classList.add("bg-background/90", "backdrop-blur-md", "shadow-sm", "py-3");
      header.classList.remove("py-4");
    } else {
      header.classList.remove("bg-background/90", "backdrop-blur-md", "shadow-sm", "py-3");
      header.classList.add("py-4");
    }
  };
  document.addEventListener("scroll", onScroll, { passive: true });
  onScroll();
</script>
