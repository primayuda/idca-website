---
import { getCollection } from "astro:content";
import { destinationRegions } from "../../content.config";

const regions = ["All", ...destinationRegions];
const destinations = (await getCollection("destinations")).sort((a, b) => a.data.order - b.data.order);
---

<section id="destinations" class="bg-elevated py-24">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <p class="font-mono-idca text-xs uppercase tracking-[0.25em] text-reef">
      <span lang="id">Wisata Bahari Nusantara</span>
      <span lang="en">Archipelago Marine Tourism</span>
    </p>
    <h2 class="mt-4 font-display text-4xl font-extrabold text-heading sm:text-5xl">
      <span lang="id">Destinasi Selam</span>
      <span lang="en">Dive Destinations</span>
    </h2>
    <p class="mt-3 max-w-2xl text-foreground/60">
      <span lang="id">
        Indonesia memiliki lebih dari 17.000 titik selam di 34 provinsi — dari kedalaman Raja
        Ampat hingga biru kristal Bunaken.
      </span>
      <span lang="en">
        Indonesia has over 17,000 dive sites across 34 provinces — from the depths of Raja Ampat
        to the crystal blue of Bunaken.
      </span>
    </p>

    <!-- Region filter -->
    <div id="region-filter" class="mt-8 flex flex-wrap gap-2">
      {
        regions.map((r, i) => (
          <button
            type="button"
            data-region={r}
            class={`region-btn rounded-full border px-4 py-2 font-display text-sm font-semibold transition-colors ${
              i === 0
                ? "border-heading bg-heading text-background"
                : "border-border text-heading/70 hover:border-heading/40"
            }`}
          >
            {r === "All" ? (
              <>
                <span lang="id">Semua</span>
                <span lang="en">All</span>
              </>
            ) : (
              r
            )}
          </button>
        ))
      }
    </div>

    <div id="destination-grid" class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        destinations.map((destination) => (
          <div
            data-region={destination.data.region}
            class={`dest-card group relative overflow-hidden rounded-2xl ${destination.data.featured ? "sm:col-span-2 sm:row-span-2" : ""}`}
          >
            <img
              src={destination.data.image}
              alt={destination.data.name}
              class={`w-full object-cover transition-transform duration-500 group-hover:scale-105 ${
                destination.data.featured ? "h-full min-h-[22rem]" : "h-64"
              }`}
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-abyss via-abyss/10 to-transparent"></div>
            <div class="absolute inset-x-0 bottom-0 p-5">
              <p class="text-xs font-semibold uppercase tracking-wide text-reef-light">{destination.data.province}</p>
              <h3 class="mt-1 font-display text-2xl font-extrabold text-foam">{destination.data.name}</h3>
              <p class="mt-1 text-sm text-foam/75">
                <span lang="id">{destination.data.tagline.id}</span>
                <span lang="en">{destination.data.tagline.en}</span>
              </p>
              <div class="mt-3 flex flex-wrap gap-2">
                {
                  destination.data.tags.map((tag) => (
                    <span class="rounded-full border border-foam/25 px-2.5 py-1 text-[11px] font-medium text-foam/80">
                      {tag}
                    </span>
                  ))
                }
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script is:inline>
  document.getElementById("region-filter")?.addEventListener("click", (e) => {
    const btn = e.target.closest(".region-btn");
    if (!btn) return;
    const region = btn.dataset.region;

    document.querySelectorAll(".region-btn").forEach((b) => {
      b.classList.remove("border-heading", "bg-heading", "text-background");
      b.classList.add("border-border", "text-heading/70");
    });
    btn.classList.add("border-heading", "bg-heading", "text-background");
    btn.classList.remove("border-border", "text-heading/70");

    document.querySelectorAll(".dest-card").forEach((card) => {
      const show = region === "All" || card.dataset.region === region;
      card.style.display = show ? "" : "none";
    });
  });
</script>
