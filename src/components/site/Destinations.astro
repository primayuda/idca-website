---
const regions = ["All", "Papua", "Sulawesi", "NTT / NTB", "Bali", "Maluku", "Kalimantan"];

const destinations = [
  {
    region: "Papua",
    image: "https://images.unsplash.com/photo-1544551763-77ef2d0cfc6c?w=900&q=85",
    province: "Papua Barat",
    name: "Raja Ampat",
    tagline: { id: "Surganya biodiversitas laut dunia", en: "The world's highest marine biodiversity" },
    tags: ["5–40m depth", "1.500+ species"],
    big: true,
  },
  {
    region: "NTT / NTB",
    image: "https://images.unsplash.com/photo-1559827260-dc66d52bef19?w=700&q=85",
    province: "NTT",
    name: "Komodo",
    tagline: { id: "Manta ray & arus kuat legendaris", en: "Legendary manta rays & strong currents" },
    tags: ["Manta Ray", "Advanced"],
  },
  {
    region: "Sulawesi",
    image: "https://images.unsplash.com/photo-1518020382113-a7e8fc38eac9?w=700&q=85",
    province: "Sulawesi Utara",
    name: "Bunaken",
    tagline: { id: "Wall diving ikonik dengan visibilitas 40m+", en: "Iconic wall diving with 40m+ visibility" },
    tags: ["Wall Dive", "All Levels"],
  },
  {
    region: "Sulawesi",
    image: "https://images.unsplash.com/photo-1682687982501-1e58ab814714?w=1000&q=85",
    province: "Sulawesi Tenggara",
    name: "Wakatobi",
    tagline: { id: "Terumbu karang pristine di jantung Coral Triangle", en: "Pristine reefs in the heart of the Coral Triangle" },
    tags: ["UNESCO", "Coral Triangle", "All Levels"],
  },
  {
    region: "Bali",
    image: "https://images.unsplash.com/photo-1583212292454-1fe6229603b7?w=700&q=85",
    province: "Bali",
    name: "Nusa Penida",
    tagline: { id: "Mola Mola & Manta Point yang memukau", en: "Stunning Mola Mola & Manta Point" },
    tags: ["Mola Mola", "Seasonal"],
  },
  {
    region: "Kalimantan",
    image: "https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=700&q=85",
    province: "Kalimantan Timur",
    name: "Derawan",
    tagline: { id: "Danau ubur-ubur & penyu hijau tak terhitung", en: "Jellyfish lake & countless green sea turtles" },
    tags: ["Turtle", "Jellyfish Lake"],
  },
  {
    region: "Maluku",
    image: "https://images.unsplash.com/photo-1519125323398-675f0ddb6308?w=700&q=85",
    province: "Maluku",
    name: "Banda Neira",
    tagline: { id: "Selam bersejarah di Kepulauan Rempah", en: "Historical diving in the Spice Islands" },
    tags: ["Wreck", "Remote"],
  },
  {
    region: "NTT / NTB",
    image: "https://images.unsplash.com/photo-1544551763-46a013bb70d5?w=700&q=85",
    province: "NTT",
    name: "Alor",
    tagline: { id: "Arus kencang, terumbu karang murni terpencil", en: "Strong currents, pristine remote coral reefs" },
    tags: ["Advanced", "Remote"],
  },
  {
    region: "Sulawesi",
    image: "https://images.unsplash.com/photo-1582967788606-a171c1080cb0?w=700&q=85",
    province: "Sulawesi Tengah",
    name: "Togean",
    tagline: { id: "Surga tersembunyi dengan biota laut yang unik", en: "Hidden paradise with unique marine biota" },
    tags: ["Beginner", "Hidden Gem"],
  },
];
---

<section id="destinations" class="bg-elevated py-24">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <p class="font-mono-idca text-xs uppercase tracking-[0.25em] text-reef">
      <span lang="id">Wisata Bahari Nusantara</span>
      <span lang="en">Archipelago Marine Tourism</span>
    </p>
    <h2 class="mt-4 font-display text-4xl font-extrabold text-heading sm:text-5xl">
      <span lang="id">Destinasi Selam</span>
      <span lang="en">Dive Destinations</span>
    </h2>
    <p class="mt-3 max-w-2xl text-foreground/60">
      <span lang="id">
        Indonesia memiliki lebih dari 17.000 titik selam di 34 provinsi — dari kedalaman Raja
        Ampat hingga biru kristal Bunaken.
      </span>
      <span lang="en">
        Indonesia has over 17,000 dive sites across 34 provinces — from the depths of Raja Ampat
        to the crystal blue of Bunaken.
      </span>
    </p>

    <!-- Region filter -->
    <div id="region-filter" class="mt-8 flex flex-wrap gap-2">
      {regions.map((r, i) => (
        <button
          type="button"
          data-region={r}
          class={`region-btn rounded-full border px-4 py-2 font-display text-sm font-semibold transition-colors ${
            i === 0
              ? "border-heading bg-heading text-background"
              : "border-border text-heading/70 hover:border-heading/40"
          }`}
        >
          {r === "All" ? (
            <>
              <span lang="id">Semua</span>
              <span lang="en">All</span>
            </>
          ) : (
            r
          )}
        </button>
      ))}
    </div>

    <div id="destination-grid" class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {destinations.map((d) => (
        <div
          data-region={d.region}
          class={`dest-card group relative overflow-hidden rounded-2xl ${d.big ? "sm:col-span-2 sm:row-span-2" : ""}`}
        >
          <img
            src={d.image}
            alt={d.name}
            class={`w-full object-cover transition-transform duration-500 group-hover:scale-105 ${
              d.big ? "h-full min-h-[22rem]" : "h-64"
            }`}
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-abyss via-abyss/10 to-transparent"></div>
          <div class="absolute inset-x-0 bottom-0 p-5">
            <p class="text-xs font-semibold uppercase tracking-wide text-reef-light">{d.province}</p>
            <h3 class="mt-1 font-display text-2xl font-extrabold text-foam">{d.name}</h3>
            <p class="mt-1 text-sm text-foam/75">
              <span lang="id">{d.tagline.id}</span>
              <span lang="en">{d.tagline.en}</span>
            </p>
            <div class="mt-3 flex flex-wrap gap-2">
              {d.tags.map((t) => (
                <span class="rounded-full border border-foam/25 px-2.5 py-1 text-[11px] font-medium text-foam/80">
                  {t}
                </span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  document.getElementById("region-filter")?.addEventListener("click", (e) => {
    const btn = e.target.closest(".region-btn");
    if (!btn) return;
    const region = btn.dataset.region;

    document.querySelectorAll(".region-btn").forEach((b) => {
      b.classList.remove("border-heading", "bg-heading", "text-background");
      b.classList.add("border-border", "text-heading/70");
    });
    btn.classList.add("border-heading", "bg-heading", "text-background");
    btn.classList.remove("border-border", "text-heading/70");

    document.querySelectorAll(".dest-card").forEach((card) => {
      const show = region === "All" || card.dataset.region === region;
      card.style.display = show ? "" : "none";
    });
  });
</script>
